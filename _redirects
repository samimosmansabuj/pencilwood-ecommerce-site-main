# 1. Old URL 301 Redirects
/product-details.html  slug=:slug   /product/:slug  301!
/index.html                         /               301!
/product-list.html                  /product-list   301!
/about-us.html                      /about-us       301!
/contact-us.html                    /contact-us     301!
/cart.html                          /cart           301!
/checkout.html                      /checkout       301!
/wishlist.html                      /wishlist       301!
/login.html                         /login          301!
/profile.html                       /profile        301!
/my-orders.html                     /my-orders      301!
/address.html                       /address        301!
/order.html                         /order          301!
/privacy-policy.html                /privacy-policy 301!
/return-policy.html                 /return-policy  301!
/terms-and-conditions.html          /terms-and-conditions 301!

# 2. Asset Rewrites under /product/
/product/css/*                      /css/:splat     200
/product/js/*                       /js/:splat      200
/product/images/*                   /images/:splat  200
/product/components/*               /components/:splat 200

# 3. Dynamic Product Details Routing
/product/:slug                      /product-details.html  200

