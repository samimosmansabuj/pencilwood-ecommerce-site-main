# ===================================================
# PENCILWOOD CLEAN URL REWRITES (.htaccess)
# For Apache / LiteSpeed / cPanel
# ===================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect direct visits to .html files to the clean URL (301 Permanent)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite API, assets, or static folders
  RewriteCond %{REQUEST_URI} ^/(api|css|js|images|components) [NC]
  RewriteRule ^ - [L]

  # Clean static HTML routes: /page -> page.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L,QSA]

  # Dynamic Product Slugs: /:slug -> product-details.html?slug=$1
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-zA-Z0-9_-]+)/?$ product-details.html?slug=$1 [L,QSA]
</IfModule>
