# ====================================================================
# Pencilwood E-Commerce - Apache / cPanel / LiteSpeed Configuration
# Clean URLs, 301 Permanent Redirects, /product/:slug dynamic routing
# ====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ----------------------------------------------------------------
    # 1. 301 REDIRECTS (Old .html URLs -> Clean URLs)
    # Uses %{THE_REQUEST} to avoid infinite redirection loops
    # ----------------------------------------------------------------

    # Redirect /index.html to /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Redirect product-details.html?slug=xyz to /product/xyz
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+product-details\.html\?slug=([^&\s]+) [NC]
    RewriteRule ^product-details\.html$ /product/%1? [R=301,L]

    # Redirect any other *.html to clean URL (e.g. /about-us.html -> /about-us)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^/?\s]+)\.html [NC]
    RewriteRule ^([^/]+)\.html$ /$1 [R=301,L]

    # ----------------------------------------------------------------
    # 2. ASSET REWRITES UNDER /product/ SUB-PATH
    # Fix relative asset requests if called from /product/:slug
    # ----------------------------------------------------------------
    RewriteRule ^product/(css|js|images|components)/(.*)$ /$1/$2 [L,NC]

    # ----------------------------------------------------------------
    # 3. DYNAMIC PRODUCT ROUTING: /product/:slug -> product-details.html
    # ----------------------------------------------------------------
    RewriteRule ^product/([^/]+)/?$ product-details.html?slug=$1 [QSA,L]

    # ----------------------------------------------------------------
    # 4. CLEAN URL REWRITING FOR STATIC PAGES
    # Serves *.html if matching file exists on disk
    # ----------------------------------------------------------------
    # Skip actual existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Check if a corresponding .html file exists
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # ----------------------------------------------------------------
    # 5. FALLBACK ROUTE TO 404
    # ----------------------------------------------------------------
    ErrorDocument 404 /404.html
</IfModule>

# --------------------------------------------------------------------
# 6. SERVICE WORKER & CACHE HEADERS
# Ensures sw.js is never cached and allowed at root scope
# --------------------------------------------------------------------
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Files>
</IfModule>
